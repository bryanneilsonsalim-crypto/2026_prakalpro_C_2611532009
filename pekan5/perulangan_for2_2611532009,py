# Buat file dengan nama perulangan_for2_NIM.py
# Buat program untuk perulangan for dalam python
# Nama variabel ditambah 4 digit nim terakhir contoh: ulang_1234
# Program ini menggunakan fungsi input()

ulang_2009 = int(input("Masukkan jumlah perulangan: "))
print("Perulangan ke-0 sampai ke-", ulang_2009-1)
for i_2009 in range(ulang_2009):
    print(i_2009, end=" ")
print()
print("Perulangan ke-1 sampai ke-", ulang_2009)
for i_2009 in range(1, ulang_2009+1):
    print(i_2009, end=" ")